# SITE_ADDRESS (dans .env) :
#   :80                    → accès par l'adresse IP, en HTTP
#   eflotte.mondomaine.com → HTTPS automatique (Let's Encrypt), DNS pointant vers l'EC2
{$SITE_ADDRESS::80} {
	encode gzip

	# 6 photos (jusqu'à 5 Mo chacune) + données du rapport
	request_body {
		max_size 40MB
	}

	# API et sa documentation
	@api path /api/* /docs /docs/* /openapi.json /health
	handle @api {
		reverse_proxy web:8050
	}

	# Application mobile : fichiers déposés dans ./telechargements sur le serveur
	# (ex. /telechargements/eflotte-camusat.apk), téléchargés directement.
	handle_path /telechargements/* {
		root * /srv/telechargements
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition "attachment; filename=\"eFlotte-Camusat.apk\""
		header Cache-Control "no-cache"
		file_server
	}

	# Site (front React servi par le conteneur eflotte-front)
	handle {
		reverse_proxy front:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
