# Copier ce fichier en .env puis adapter les valeurs :  cp .env.example .env
# Le fichier .env n'est jamais commité (.gitignore).

# ── Base PostgreSQL (service "db" du docker-compose) ──────────────────────────
POSTGRES_USER=flotte_user
POSTGRES_PASSWORD=FlottePass2025
POSTGRES_DB=eflotte
# Port exposé sur la machine (pgAdmin, DBeaver…)
DB_PORT=5435

# ── API ───────────────────────────────────────────────────────────────────────
# Clé de signature des jetons JWT : mettre une valeur longue et aléatoire
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-secret-key-eflotte
# Port exposé sur la machine
API_PORT=8050

# ── Hors Docker uniquement (uvicorn lancé à la main, Render, Neon…) ───────────
# Avec docker compose, l'URL est construite à partir des variables POSTGRES_*
# ci-dessus et cette ligne est ignorée.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
