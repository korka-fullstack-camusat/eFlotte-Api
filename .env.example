# Copier ce fichier en .env puis adapter les valeurs :  cp .env.example .env
# Le fichier .env n'est jamais commité (.gitignore).

# ── Base PostgreSQL (service "db" du docker-compose) ──────────────────────────
POSTGRES_USER=flotte_user
POSTGRES_PASSWORD=FlottePass2025
POSTGRES_DB=eflotte
# Port exposé sur la machine (pgAdmin, DBeaver…)
DB_PORT=5435

# ── API ───────────────────────────────────────────────────────────────────────
# Clé de signature des jetons JWT : mettre une valeur longue et aléatoire
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-secret-key-eflotte
# Port exposé sur la machine
API_PORT=8050

# ── Comptes chauffeurs (import en masse) ─────────────────────────────────────
# Mot de passe donné à chaque compte importé (à changer à la 1re connexion)
CHAUFFEUR_MOT_DE_PASSE_INITIAL=Camusat@2026
# Adresse de la plateforme envoyée dans le SMS
APP_URL=https://eflotte.camusatsn.com
# Lien de téléchargement de l'app mobile Android (APK EAS) : remplace APP_URL dans le SMS
# des chauffeurs. Laisser vide tant que l'APK n'est pas publié.
APP_MOBILE_URL=

# ── SMS : Orange SMS Pro Sénégal ─────────────────────────────────────────────
# Identifiants du compte Orange SMS Pro (à ne JAMAIS mettre dans le code / Git).
# Laisser vide pour désactiver les SMS.
ORANGE_SMS_LOGIN=
ORANGE_SMS_TOKEN=
ORANGE_SMS_ACCESS_KEY=
# Nom d'expéditeur affiché sur le téléphone
ORANGE_SMS_SIGNATURE=CAMUSAT SN
ORANGE_SMS_BASE_URL=https://api.orangesmspro.sn:8443/api
ORANGE_SMS_VERIFY_SSL=True

# ── Production (docker-compose.prod.yml) ──────────────────────────────────────
# ":80" pour accéder par l'adresse IP de l'EC2 (HTTP).
# Un nom de domaine (ex : eflotte.camusat.sn) pour le HTTPS automatique.
SITE_ADDRESS=:80

# Ports de Caddy sur le serveur (docker-compose.prod.yml). Par défaut 80 / 443.
# Si 80 / 443 sont déjà utilisés par un autre proxy qui gère le HTTPS du domaine :
#   CADDY_HTTP_PORT=8050, CADDY_HTTPS_PORT=8443 et SITE_ADDRESS=:80,
#   puis faire pointer le domaine (dans cet autre proxy) vers http://127.0.0.1:8050
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ── Hors Docker uniquement (uvicorn lancé à la main, Render, Neon…) ───────────
# Avec docker compose, l'URL est construite à partir des variables POSTGRES_*
# ci-dessus et cette ligne est ignorée.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
